+/* 0195: only ever called for BUCK2 with a level's voltage (or the one read before) */
+static int
+pm_set_buck2(uint32_t uv)
+{
+	uint8_t sel, back = 0, msg[2];
+	if (uv < 550000 || uv > BUCK2_MAX_UV) {
+		printf("USB> pmic: refusing BUCK2 %u uV\n", uv);
+		return -1;
+	}
+	sel = (uint8_t)((uv - 400000 + 6249) / 6250);
+	msg[0] = PMIC_B2CTRL2;
+	msg[1] = sel;
+	if (pm_xfer(false, msg, 2, true)) {
+		return -1;
+	}
+	delay(1000);
+	if (pm_read(PMIC_B2CTRL2, &back) || back != sel) {
+		printf("USB> pmic: BUCK2 read back 0x%02x, wanted 0x%02x\n", back, sel);
+		return -1;
+	}
+	return 0;
+}
