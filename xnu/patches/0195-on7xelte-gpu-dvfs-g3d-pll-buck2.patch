+/* ---- GPU (G3D) ---- */
+
+/* CMU_G3D / SYSREG_G3D are only read with the G3D power domain on: a read with it off hangs the bus */
+static bool
+gv_on(void)
+{
+	return (rd32(dv.pmu, PMU_G3D_STATUS) & 0xf) == 0xf;
+}
+
+static void
+gv_show(void)
+{
+	uint8_t c1 = 0, c2 = 0;
+	if (!gv_on()) {
+		printf("USB> gpufreq: G3D domain off (PMU status 0x%08x)\n", rd32(dv.pmu, PMU_G3D_STATUS));
+		return;
+	}
+	uint32_t con0 = rd32(dv.g3d_cmu, PLL_CON0);
+	printf("USB> gpufreq: G3D_PLL 0x%08x = %u kHz%s, mux 0x%08x, div bus %u apb %u, EMA %02x %02x %02x\n",
+	    con0, pll_khz(con0), (con0 & (1u << 29)) ? " locked" : "", rd32(dv.g3d_cmu, MUX_CPU_PLL),
+	    rd32(dv.g3d_cmu, 0x400) & 0xf, rd32(dv.g3d_cmu, 0x404) & 0xf, rd32(dv.g3d_sysreg, G3D_EMA_RA1),
+	    rd32(dv.g3d_sysreg, G3D_EMA_RF1), rd32(dv.g3d_sysreg, G3D_EMA_RF2));
+	if (pm_read(PMIC_B2CTRL1, &c1) == 0 && pm_read(PMIC_B2CTRL2, &c2) == 0) {
+		printf("USB> gpufreq: BUCK2 ctrl1 0x%02x, vsel 0x%02x = %u uV, %d C\n", c1, c2, BUCK1_UV(c2), dv_temp());
+	}
+}
+
+static void
+gv_ema(uint32_t uv)
+{
+	wr32(dv.g3d_sysreg, G3D_EMA_RA1, 0x12);
+	wr32(dv.g3d_sysreg, G3D_EMA_RF1, 0x12);
+	wr32(dv.g3d_sysreg, G3D_EMA_RF2, uv >= 750000 ? 0x22 : 0x24);
+}
+
+static int
+gv_set(uint32_t khz)
+{
+	int lv = -1;
+	uint8_t vsel = 0;
+	uint32_t cur_uv, con0;
+
+	for (int i = 0; i < (int)(sizeof(gv_lv) / sizeof(gv_lv[0])); i++) {
+		if (khz / 1000 == gv_lv[i].khz / 1000) {
+			lv = i;
+			break;
+		}
+	}
+	if (lv < 0) {
+		printf("USB> gpufreq: levels 1001 845 728 676 545 450 343\n");
+		return -1;
+	}
+	if (gv_lv[lv].uv > BUCK2_MAX_UV) {
+		return -1;
+	}
+	if (!gv_on()) {
+		printf("USB> gpufreq: G3D domain off, nothing changed\n");
+		return -1;
+	}
+	int t = dv_temp();
+	if (gv_lv[lv].khz > 545000 && t >= DV_HOT_C) {
+		printf("USB> gpufreq: %d C, not raising\n", t);
+		return -1;
+	}
+	con0 = rd32(dv.g3d_cmu, PLL_CON0);
+	if (!(con0 & (1u << 31)) || !((rd32(dv.g3d_cmu, MUX_CPU_PLL) >> 12) & 1)) {
+		printf("USB> gpufreq: G3D_PLL off or not selected (0x%08x)\n", con0);
+		return -1;
+	}
+	if (pm_read(PMIC_B2CTRL2, &vsel)) {
+		return -1;
+	}
+	cur_uv = BUCK1_UV(vsel);
+	if (cur_uv < 550000 || cur_uv > 1100000) {
+		printf("USB> gpufreq: BUCK2 reads %u uV, giving up\n", cur_uv);
+		return -1;
+	}
+
+	/* up: voltage, EMA, clock. down: clock, EMA, voltage. */
+	if (gv_lv[lv].uv > cur_uv) {
+		if (pm_set_buck2(gv_lv[lv].uv)) {
+			return -1;
+		}
+		gv_ema(gv_lv[lv].uv);
+	}
+	con0 &= ~((0x3ffu << 16) | (0x3fu << 8) | 7u);
+	con0 |= ((uint32_t)gv_lv[lv].m << 16) | ((uint32_t)gv_lv[lv].p << 8) | gv_lv[lv].s;
+	con0 &= ~(1u << 26);
+	con0 |= (1u << 5);
+	if (pll_set(dv.g3d_cmu, con0, gv_lv[lv].p)) {
+		printf("USB> gpufreq: G3D_PLL failed, now 0x%08x; BUCK2 left at %u uV\n", rd32(dv.g3d_cmu, PLL_CON0),
+		    cur_uv > gv_lv[lv].uv ? cur_uv : gv_lv[lv].uv);
+		gv_show();
+		return -1;
+	}
+	if (gv_lv[lv].uv < cur_uv) {
+		gv_ema(gv_lv[lv].uv);
+		pm_set_buck2(gv_lv[lv].uv);
+	}
+	dv.gpu_khz = gv_lv[lv].khz;
+	printf("USB> gpufreq: %u kHz at %u uV (G3D_PLL 0x%08x), %d C\n", gv_lv[lv].khz,
+	    gv_lv[lv].uv > cur_uv || gv_lv[lv].uv < cur_uv ? gv_lv[lv].uv : cur_uv, rd32(dv.g3d_cmu, PLL_CON0), dv_temp());
+	return 0;
+}
