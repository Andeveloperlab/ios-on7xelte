 	printf(PORT_NAME " Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+	if (on7gl) {
+		error = mac_policy_register(&on7gl_amfi_mac_conf, &on7gl_amfi_mac_handle, NULL);
+		printf("ON7 GL: AMFI dyld policy (backboardd only) %s (%d)\n",
+		    error ? "NOT registered" : "registered", error);
+	}
 }
