+/*
+ * 0188: the present thread shows the frame the vsync tick handed over; the
+ * scale is split by panel rows between it and fWorkers-1 helper threads
+ * (boot-arg sweetfb_workers, default 4, 1 = no helpers).
+ */
+void
+AppleCLCD::presenterMain(void *arg, wait_result_t wr)
+{
+	AppleCLCD *fb = (AppleCLCD *)arg;
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+
+	(void)wr;
+	for (;;) {
+		IOLockLock(fb->fLock);
+		while (!fb->fPresentReady) {
+			IOLockSleep(fb->fLock, &fb->fPresentReady, THREAD_UNINT);
+		}
+		fb->fPresentReady = false;
+		memcpy(rec, fb->fPresentRec, SWEET_FB_SWAP_REC_SIZE);
+		IOLockUnlock(fb->fLock);
+		uint64_t t0 = mach_absolute_time();
+		fb->present(rec);
+		sweet_fb_stat_present(mach_absolute_time() - t0);
+		IOLockLock(fb->fLock);
+		fb->fPresentBusy = false;
+		IOLockUnlock(fb->fLock);
+	}
+}
+
+void
+AppleCLCD::workerMain(void *arg, wait_result_t wr)
+{
+	AppleCLCD *fb = ((AppleCLCD **)arg)[0];
+	uint32_t idx = *(uint32_t *)((uint8_t *)arg + sizeof(AppleCLCD *));
+	uint32_t seen = 0;
+
+	(void)wr;
+	for (;;) {
+		IOLockLock(fb->fJobLock);
+		while (fb->fJobGen == seen) {
+			IOLockSleep(fb->fJobLock, &fb->fJobGen, THREAD_UNINT);
+		}
+		seen = fb->fJobGen;
+		IOLockUnlock(fb->fJobLock);
+		fb->scaleRows(idx, fb->fWorkers, fb->fRowBuf[idx]);
+		IOLockLock(fb->fJobLock);
+		if (++fb->fJobDone == fb->fWorkers - 1) {
+			IOLockWakeup(fb->fJobLock, &fb->fJobDone, true);
+		}
+		IOLockUnlock(fb->fJobLock);
+	}
+}
+
+void
+AppleCLCD::startPresenter()
+{
+	uint32_t workers = 4;
+	thread_t th;
+
+	(void)PE_parse_boot_argn("sweetfb_workers", &workers, sizeof(workers));
+	if (workers < 1) {
+		workers = 1;
+	}
+	if (workers > SWEET_FB_WORKERS_MAX) {
+		workers = SWEET_FB_WORKERS_MAX;
+	}
+	fWorkers = 1;
+	if (!fScaled) {
+		workers = 1;
+	}
+	fJobLock = IOLockAlloc();
+	if (fJobLock == NULL) {
+		return;
+	}
+	for (uint32_t i = 0; i < workers; i++) {
+		fRowBuf[i] = (uint32_t *)IOMallocData((fLogicalW + 2) * sizeof(uint32_t));
+		if (fRowBuf[i] == NULL) {
+			IOLog("SWEET FB: no row buffer %u\n", i);
+			return;
+		}
+	}
+	if (kernel_thread_start(&AppleCLCD::presenterMain, this, &th) != KERN_SUCCESS) {
+		IOLog("SWEET FB: no present thread, presenting from vsync\n");
+		return;
+	}
+	thread_deallocate(th);
+	fPresenter = true;
+	for (uint32_t i = 1; i < workers; i++) {
+		fWorkerArg[i].fb = this;
+		fWorkerArg[i].idx = i;
+		if (kernel_thread_start(&AppleCLCD::workerMain, &fWorkerArg[i], &th) != KERN_SUCCESS) {
+			break;
+		}
+		thread_deallocate(th);
+		fWorkers = i + 1;
+	}
+	IOLog("SWEET FB: present thread + %u scale parts\n", fWorkers);
 }
 
