+/* Two BGRA pixels at once: per-channel floor average, as sweet_fb_avg. */
+typedef uint64_t sweet_fb_u64u __attribute__((aligned(4), may_alias));
+
+static inline uint64_t
+sweet_fb_avg2(uint64_t a, uint64_t b)
+{
+	return (a & b) + (((a ^ b) & 0xfefefefefefefefeULL) >> 1);
+}
