 static IOBufferMemoryDescriptor *on7_gpu_mem;
 
+/*
+ * 0192: Mali interrupts. This port has no SPI dispatcher (USB, Wi-Fi and the
+ * a50 port's Mali all poll), so sleh_irq (osfmk/arm64/sleh.c, A5XELTE) calls
+ * on7_mali_irq() for INTID 313-315 (exynos7870.dtsi mali: SPI 282 JOB,
+ * 283 MMU, 281 GPU; INTID = SPI + 32). The GIC-400 distributor
+ * (GICD 0x104e1000) gets priority 0xa0, target CPU interface 0 and enable for
+ * the three lines; the group bit is only logged (secure-only to write).
+ * In IRQ context: read the block's IRQ_STATUS, clear it, count it,
+ * thread_wakeup on the counter. No logging there.
+ */
+extern "C" wait_result_t assert_wait_timeout(event_t event, wait_interrupt_t interruptible,
+    uint32_t interval, uint32_t scale_factor);
+extern "C" wait_result_t thread_block(thread_continue_t continuation);
+extern "C" kern_return_t thread_wakeup_prim(event_t event, boolean_t one_thread, wait_result_t result);
+
+#define ON7_GICD_PA             0x104e1000ULL
+#define ON7_MALI_INTID_GPU      313
+
+static volatile uint32_t *on7_gpu_regs;
+static volatile uint32_t *on7_gicd;
+static volatile uint32_t on7_mali_irq_n[3];     /* GPU, JOB, MMU */
+static volatile uint32_t on7_mali_irq_st[3];    /* OR of every status seen */
+static volatile uint32_t on7_mali_irq_spurious;
+
+extern "C" int
+on7_mali_irq(uint32_t intid)
+{
+	volatile uint32_t *gpu = on7_gpu_regs;
+	if (gpu == NULL) {
+		return 0;
+	}
+	unsigned k = intid - ON7_MALI_INTID_GPU;        /* 0 GPU, 1 JOB, 2 MMU */
+	uint32_t b = k * 0x1000;
+	uint32_t st = gpu[(b + (k == 0 ? 0x2c : 0x0c)) / 4];
+	if (st == 0) {
+		on7_mali_irq_spurious++;
+		return 1;
+	}
+	gpu[(b + (k == 0 ? 0x24 : 0x04)) / 4] = st;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	on7_mali_irq_st[k] |= st;
+	on7_mali_irq_n[k]++;
+	thread_wakeup_prim((event_t)&on7_mali_irq_n[k], FALSE, THREAD_AWAKENED);
+	return 1;
+}
+
+static void
+on7_mali_gic_log(const char *when)
+{
+	volatile uint32_t *d = on7_gicd;
+	uint32_t w = ON7_MALI_INTID_GPU / 32;   /* word 9: INTIDs 288-319, ours bits 25-27 */
+	IOLog("ON7 MALI: GIC %s: ctlr %08x group %08x enable %08x pending %08x active %08x prio %08x target %08x cfg %08x\n",
+	    when, d[0], d[(0x080 + 4 * w) / 4], d[(0x100 + 4 * w) / 4], d[(0x200 + 4 * w) / 4],
+	    d[(0x300 + 4 * w) / 4], d[(0x400 + 312) / 4], d[(0x800 + 312) / 4], d[(0xc00 + 4 * 19) / 4]);
+}
+
+static void
+on7_mali_irq_setup(volatile uint32_t *gpu)
+{
+	on7_gicd = (volatile uint32_t *)ml_io_map(ON7_GICD_PA, 0x1000);
+	if (on7_gicd == NULL) {
+		IOLog("ON7 MALI: no GICD mapping\n");
+		return;
+	}
+	volatile uint8_t *gb = (volatile uint8_t *)on7_gicd;
+	on7_mali_gic_log("before");
+	on7_wr(gpu, MALI_GPU_IRQ_MASK, 0);
+	on7_wr(gpu, MALI_JOB_IRQ_MASK, 0);
+	on7_wr(gpu, MALI_MMU_IRQ_MASK, 0);
+	on7_wr(gpu, MALI_GPU_IRQ_CLEAR, 0xffffffffu);
+	on7_wr(gpu, MALI_JOB_IRQ_CLEAR, 0xffffffffu);
+	on7_wr(gpu, MALI_MMU_IRQ_CLEAR, 0xffffffffu);
+	on7_gpu_regs = gpu;
+	for (uint32_t id = ON7_MALI_INTID_GPU; id < ON7_MALI_INTID_GPU + 3; id++) {
+		gb[0x400 + id] = 0xa0;
+		gb[0x800 + id] = 0x01;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	on7_gicd[(0x100 + 4 * (ON7_MALI_INTID_GPU / 32)) / 4] = 7u << (ON7_MALI_INTID_GPU % 32);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* GPU: fault, multiple faults, clean caches done; JOB: done + failed for 3 slots;
+	 * MMU: page fault + bus error for 8 address spaces */
+	on7_wr(gpu, MALI_GPU_IRQ_MASK, 1u | (1u << 7) | MALI_IRQ_CLEAN_DONE);
+	on7_wr(gpu, MALI_JOB_IRQ_MASK, 0x00070007u);
+	on7_wr(gpu, MALI_MMU_IRQ_MASK, 0x00ff00ffu);
+	on7_mali_gic_log("enabled");
+}
+
