+	IOLog("ON7 MALI: irq job chain: wait %s after %llu us, JOB irqs %u (+%u) status seen %08x; exceptions %08x/%08x cycles %08x%08x timestamp %08x%08x; job_raw now %08x\n",
+	    w == THREAD_AWAKENED ? "woken" : "TIMED OUT", ns / 1000, on7_mali_irq_n[1], on7_mali_irq_n[1] - c0,
+	    on7_mali_irq_st[1], job[0], job2[0], target[1], target[0], target[3], target[2],
+	    on7_rd(gpu, MALI_JOB_IRQ_RAWSTAT));
+
+	c0 = on7_mali_irq_n[0];
+	a0 = mach_absolute_time();
+	assert_wait_timeout((event_t)&on7_mali_irq_n[0], THREAD_UNINT, 100, 1000 * 1000);
+	on7_wr(gpu, MALI_GPU_COMMAND, MALI_CMD_CLEAN_CACHES);
+	w = thread_block(THREAD_CONTINUE_NULL);
+	absolutetime_to_nanoseconds(mach_absolute_time() - a0, &ns);
+	IOLog("ON7 MALI: irq clean caches: wait %s after %llu us, GPU irqs %u (+%u) status seen %08x; MMU irqs %u; spurious %u; gpu_raw now %08x\n",
+	    w == THREAD_AWAKENED ? "woken" : "TIMED OUT", ns / 1000, on7_mali_irq_n[0], on7_mali_irq_n[0] - c0,
+	    on7_mali_irq_st[0], on7_mali_irq_n[2], on7_mali_irq_spurious, on7_rd(gpu, MALI_GPU_IRQ_RAWSTAT));
+	on7_mali_gic_log("after test");
 }
 
