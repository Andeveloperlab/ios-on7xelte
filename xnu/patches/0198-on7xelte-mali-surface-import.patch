+/*
+ * 0198: what the display asks before it reads a surface's pixels (AppleCLCD::present): if the Mali
+ * drew it, wait for the surface's last job (at most 100 ms) and drop the processor's lines of it.
+ */
+static void
+on7_mali_surface_drawn(SweetSurface *s)
+{
+	uint64_t seq = 0;
+	bool used = false;
+
+	if (gMaliLock == NULL || s == NULL) {
+		return;
+	}
+	IOLockLock(gMaliLock);
+	unsigned slot = s->id % ON7_MALI_SURFACES;
+	if (on7_mali_surface_seq[slot].id == s->id) {
+		seq = on7_mali_surface_seq[slot].seq;
+		used = true;
+	}
+	IOLockUnlock(gMaliLock);
+	if (!used) {
+		return;
+	}
+	if (seq != 0 && !hakios_mali_wait(seq, 100ull * NSEC_PER_MSEC) && on7_mali_surface_late++ < 8) {
+		IOLog("ON7 MALI: surface %u shown before its job %llu was done\n", s->id, seq);
+	}
+	on7_mali_surface_waits++;
+	on7_mali_surface_flush(s);
+}
