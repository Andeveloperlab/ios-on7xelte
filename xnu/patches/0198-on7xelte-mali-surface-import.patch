+on7_mali_surface_flush(SweetSurface *s)
+{
+	IOBufferMemoryDescriptor *buffer = OSDynamicCast(IOBufferMemoryDescriptor, s->memory);
+
+	if (buffer != NULL && buffer->getLength() != 0) {
+		FlushPoC_DcacheRegion((vm_offset_t)buffer->getBytesNoCopy(), (size_t)buffer->getLength());
+	}
+}
