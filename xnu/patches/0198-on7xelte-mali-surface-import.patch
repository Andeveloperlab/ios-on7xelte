+/*
+ * 0198: the pixels of an IOSurface as a buffer (the a50's surfaceBuffer): what the window server
+ * draws into, and what is shown. The surface is held for as long as the buffer is there; a surface
+ * that is a buffer of this client's already is that buffer again. Asked only to describe
+ * (kMaliDescribe), no buffer is made. Only surfaces of wired kernel memory (SweetSurface create):
+ * not the panel's own surface (its memory is outside the kernel's map of RAM). gMaliLock is held.
+ */
+IOReturn
+HakiosMaliUserClient::surfaceBuffer(struct mali_surface *request)
+{
+	static uint32_t logged;
+	SweetSurface *s = sweet_surface_copy(request->surface);
+	IOBufferMemoryDescriptor *memory;
+	struct mali_buffer *b = NULL;
+	uint64_t size, address;
+	bool mapped = true;
+
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	memory = OSDynamicCast(IOBufferMemoryDescriptor, s->memory);
+	size = memory != NULL ? round_page_64(memory->getLength()) : 0;
+	if (memory == NULL || size == 0 || size > MALI_BUFFER_MAX || s->elementWidth != 1 || s->elementHeight != 1) {
+		if (logged++ < 16) {
+			IOLog("ON7 MALI: surface %u (%ux%u fmt 0x%x) cannot be a buffer\n", s->id, s->width, s->height,
+			    s->pixelFormat);
+		}
+		s->release();
+		return kIOReturnUnsupported;
+	}
+	request->size = size;
+	request->offset = s->offset;
+	request->rowBytes = s->bytesPerRow;
+	request->width = s->width;
+	request->height = s->height;
+	request->pixelFormat = s->pixelFormat;
+	request->planes = s->planeCount;
+	if (request->handle == kMaliDescribe) {
+		request->handle = 0;
+		s->release();
+		return kIOReturnSuccess;
+	}
+	for (uint32_t i = 0; i < MALI_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s) {
+			request->handle = i + 1;
+			s->release();
+			return kIOReturnSuccess;
+		}
+	}
+	for (uint32_t n = 0; n < MALI_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % MALI_BUFFERS;
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL) {
+		s->release();
+		return kIOReturnNoResources;
+	}
+	address = hakios_mali_address(size, false);
+	for (uint64_t o = 0; o < memory->getLength() && mapped && address != 0; o += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(o, &length, kIOMemoryMapperNone);
+		mapped = phys != 0 && hakios_mali_map(address + o, phys);
+	}
+	if (address == 0 || !mapped) {
+		if (address != 0) {
+			hakios_mali_unmap(address, size);
+		}
+		IOLog("ON7 MALI: surface %u (%llu bytes) cannot be entered into the GPU's addresses (pt pool %u/%u)\n",
+		    s->id, size, on7_pool_used, on7_pool_pages);
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	hakios_mali_mapped();
+	on7_mali_surface_flush(s);
+	memory->retain();
+	b->memory = memory;
+	b->surface = s;                         /* the reference sweet_surface_copy gave */
+	b->address = address;
+	b->size = size;
+	b->last_seq = 0;
+	OSIncrementAtomic((SInt32 *)&gMaliBuffers);
+	if (logged++ < 16) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("ON7 MALI: %s: surface %u (%ux%u fmt 0x%x, %u bytes a row) is buffer %u at GPU 0x%llx\n", name,
+		    s->id, s->width, s->height, s->pixelFormat, s->bytesPerRow, request->handle, address);
+	}
+	return kIOReturnSuccess;
+}
